APP_ENV=development
# скопіюй у .env і заміни значення. .env НЕ комітити в git
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://booking:change-me@db:5432/booking
# Окремий випадковий webhook-secret; це НЕ Private API key акаунта Vapi.
VAPI_SECRET=change-me-to-a-long-random-string
# токен від @BotFather
TG_BOT_TOKEN=
# ID приватної групи адміністраторів або кількох чатів через кому.
# Для приватних особистих чатів кожен адміністратор спершу має натиснути /start.
TG_ADMIN_IDS=
# Точні DNS-хости з URL запису Vapi, через кому; невідомі хости не завантажуються.
VAPI_RECORDING_HOSTS=
