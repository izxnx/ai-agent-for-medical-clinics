APP_ENV=development
# скопіюй у .env і заміни значення. .env НЕ комітити в git
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://booking:change-me@db:5432/booking
# API key з Retell Dashboard -> Settings -> API Keys, саме той, що має позначку "webhook".
# Ним Retell підписує запити (X-Retell-Signature), а бекенд перевіряє підпис і читає записи дзвінків.
RETELL_API_KEY=
# Запис не пересилається в Telegram, доки явно не ввімкнути цей параметр.
FORWARD_RECORDINGS_TO_TELEGRAM=false
# токен від @BotFather
TG_BOT_TOKEN=
# ID приватної групи адміністраторів або кількох чатів через кому.
# Для приватних особистих чатів кожен адміністратор спершу має натиснути /start.
TG_ADMIN_IDS=
# Точні DNS-хости, з яких Retell віддає recording_url (через кому). Лише для пересилання записів.
RETELL_RECORDING_HOSTS=
