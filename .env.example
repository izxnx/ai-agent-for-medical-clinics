# скопіюй у .env і заміни значення. .env НЕ комітити в git
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://booking:change-me@db:5432/booking
# довгий випадковий рядок; такий самий вкажеш у Vapi
VAPI_SECRET=change-me-to-a-long-random-string
# токен від @BotFather
TG_BOT_TOKEN=
# Telegram ID адмінів через кому. Для особистих чатів кожен адмін має натиснути /start у боті.
# Можна вказати і id групи (воно від'ємне, напр. -100123...)
TG_ADMIN_IDS=
